---
import Base from '../layouts/Base.astro';
import RapidReview from '../components/RapidReview.svelte';
import Icon from '../components/Icon.astro';
import { COMPARISONS, FLASHCARDS, QUICK_FACTS } from '../data/review';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---

<Base
  title="Rapid review"
  description="Flashcards, service comparisons and facts to know for Exam AI-901."
  active="review"
>
  <div class="wrap">
    <header class="page-head head">
      <div>
        <h1>Rapid review</h1>
        <p>
          {FLASHCARDS.length} flashcards, {COMPARISONS.length} comparisons and {QUICK_FACTS.length} facts:
          the terms and distinctions the exam deliberately blurs. For revising, not for learning from
          scratch.
        </p>
      </div>
      <a class="btn" href={href('/cram/')}><Icon name="cram" /> The cram sheet</a>
    </header>
    <RapidReview client:load />
  </div>
</Base>

<style>
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    max-width: none;
  }
  .head > div {
    max-width: var(--measure);
  }
</style>
