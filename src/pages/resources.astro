---
import Base from '../layouts/Base.astro';
import ResourcesHub from '../components/ResourcesHub.svelte';
import { OFFICIAL_RESOURCES } from '../data/resources';
---

<Base
  title="Official resources"
  description="Every official link worth having for Exam AI-901: the study guide, practice assessment, exam sandbox, Microsoft Learn training, labs, and the Microsoft Foundry and Foundry Tools documentation."
  active="resources"
>
  <div class="wrap">
    <header class="page-head">
      <h1>Official resources</h1>
      <p>
        {OFFICIAL_RESOURCES.length} links to Microsoft Learn, the exam itself, the labs and the product
        documentation. Each one was checked before it went in.
      </p>
    </header>
    <ResourcesHub client:load />
  </div>
</Base>
