---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/Dashboard.svelte';
import KnowledgeCheck from '../components/lesson/KnowledgeCheck.svelte';
import Icon from '../components/Icon.astro';
import { ALL_QUESTIONS, QUESTION_BY_ID } from '../data/questions';
import { MODULES, TOTAL_LESSON_MINUTES } from '../data/modules';
import { DOMAINS, EXAM } from '../data/exam';
import { OFFICIAL_RESOURCES } from '../data/resources';
import { SPRINT_PLAN } from '../data/roadmap';
import { moduleRefs, questionRefs } from '../lib/pageData';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, '')}${p}`;

const hours = Math.round((TOTAL_LESSON_MINUTES / 60) * 10) / 10;
const first = MODULES[0]!;
// A real exam-style question, chosen because older notes get it wrong.
const sample = QUESTION_BY_ID['fg-011']!;
const studyDays = SPRINT_PLAN.filter((d) => d.id.startsWith('day-')).length;
// Midpoint of each domain's published range, e.g. "40–45%" -> 42.5, for the split bar.
const share = (weightLabel: string) => {
  const [lo = 0, hi = lo] = weightLabel.match(/\d+/g)?.map(Number) ?? [];
  return (lo + hi) / 2;
};
---

<Base
  title="Learn AI-901: a free study guide for Azure AI Fundamentals"
  description={`A free, up-to-date study guide for Microsoft Exam AI-901: Azure AI Fundamentals. ${MODULES.length} lessons, ${ALL_QUESTIONS.length} practice questions that explain every wrong answer, spaced repetition and a timed practice exam.`}
  active="home"
>
  <div class="wrap">
    <div class="for-returning">
      <Dashboard client:load {base} refs={questionRefs} modules={moduleRefs} resourceCount={OFFICIAL_RESOURCES.length} />
    </div>

    <div class="for-new">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-text">
          <p class="status">
            <span class="status-dot" aria-hidden="true"></span>
            Covers the skills measured as of {EXAM.skillsMeasuredDate}
          </p>
          <h1 id="hero-title">Study for AI-901 and know when you are ready</h1>
          <p class="lead">
            A free study guide for Microsoft Exam AI-901: Azure AI Fundamentals. {MODULES.length} short
            lessons, {ALL_QUESTIONS.length} practice questions that explain why every wrong answer is wrong,
            and a timed practice exam that shows which topics still need work.
          </p>
          <div class="cta row">
            <a class="btn btn-primary btn-lg" href={href(`/learn/${first.id}/`)}>Start lesson 1</a>
            <a class="btn btn-lg" href={href('/practice/?start=quick')}>Answer 10 questions first</a>
          </div>
          <ul class="promises small">
            <li><Icon name="check" size={16} />Free</li>
            <li><Icon name="check" size={16} />No account</li>
            <li><Icon name="check" size={16} />Progress stays in this browser</li>
          </ul>
        </div>
        <div class="hero-sample">
          <p class="sample-label small">Try one now. Older study notes get this wrong.</p>
          <div class="deck">
            <span class="deck-card deck-2" aria-hidden="true"></span>
            <span class="deck-card deck-1" aria-hidden="true"></span>
            <KnowledgeCheck client:visible question={sample} />
          </div>
        </div>
      </section>

      <section class="facts" aria-labelledby="facts-title">
        <div class="section-title">
          <h2 id="facts-title">The exam at a glance</h2>
        </div>
        <dl class="fact-grid sheet">
          <div>
            <dt>Time</dt>
            <dd>
              <span class="fact-value num">{EXAM.durationMinutes} min</span>
              to answer, inside about {EXAM.seatMinutes} minutes in the seat
            </dd>
          </div>
          <div>
            <dt>Questions</dt>
            <dd>
              <span class="fact-value num">{EXAM.questionCountLabel.replace('–', ' to ')}</span>
              on most Microsoft exams, in several formats
            </dd>
          </div>
          <div>
            <dt>Pass mark</dt>
            <dd>
              <span class="fact-value num">700</span>
              on a scaled 1 to 1,000. Wrong answers cost nothing, so never leave one blank
            </dd>
          </div>
          <div>
            <dt>Looking things up</dt>
            <dd>
              <span class="fact-value">Not allowed</span>
              Fundamentals exams do not give you Microsoft Learn during the exam
            </dd>
          </div>
        </dl>
        <div class="domains sheet">
          <div class="domains-head">
            <h3>What is measured</h3>
            <a class="small" href={EXAM.studyGuideUrl}>
              Official study guide<Icon name="external" size={14} label="(opens Microsoft Learn)" />
            </a>
          </div>
          <div class="split" aria-hidden="true">
            {DOMAINS.map((d, i) => <span class={`split-${i}`} style={`flex: ${share(d.weightLabel)}`} />)}
          </div>
          <ul>
            {
              DOMAINS.map((d, i) => (
                <li>
                  <span class={`swatch split-${i}`} aria-hidden="true" />
                  <span>{d.label}</span>
                  <strong class="num">{d.weightLabel.replace('–', ' to ')}</strong>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="loop" aria-labelledby="loop-title">
        <div class="section-title">
          <h2 id="loop-title">How it works</h2>
        </div>
        <ol class="steps">
          <li>
            <span class="step-icon" aria-hidden="true"><Icon name="learn" size={22} /></span>
            <h3><span class="step-no num">1.</span> Learn</h3>
            <p>
              {MODULES.length} lessons, about {hours} hours in all, with the exam traps and the things
              Microsoft renamed called out as you go.
            </p>
            <a href={href('/learn/')}>See the lessons</a>
          </li>
          <li>
            <span class="step-icon" aria-hidden="true"><Icon name="practice" size={22} /></span>
            <h3><span class="step-no num">2.</span> Practise</h3>
            <p>
              Every answer is marked straight away. What you miss comes back at spaced intervals until it
              sticks, and your weakest topics rise to the top.
            </p>
            <a href={href('/practice/')}>Practise questions</a>
          </li>
          <li>
            <span class="step-icon" aria-hidden="true"><Icon name="exam" size={22} /></span>
            <h3><span class="step-no num">3.</span> Sit a practice exam</h3>
            <p>
              45 questions in 45 minutes, weighted like the real blueprint, with nothing marked until the
              end and a report by topic.
            </p>
            <a href={href('/exam/')}>Try the practice exam</a>
          </li>
        </ol>
      </section>

      <section class="plan" aria-labelledby="plan-title">
        <div>
          <h2 id="plan-title">Short on time?</h2>
          <p>
            The {studyDays}-day plan front-loads the heaviest topics and ends every day with practice
            questions, then gives you a calm exam morning.
          </p>
        </div>
        <a class="btn btn-lg plan-btn" href={href('/plan/')}>See the {studyDays}-day plan</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    padding: clamp(0.5rem, 0.2rem + 2vw, 2.5rem) 0 1rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--border),
      var(--shadow-xs);
    color: var(--ink-2);
    font-size: 0.85rem;
    font-weight: 550;
  }
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px var(--success-soft);
  }

  .hero-text h1 {
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 14ch;
    margin-bottom: 0.4em;
  }
  .lead {
    max-width: 50ch;
    color: var(--ink-2);
    font-size: clamp(1.06rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.6;
  }
  .cta {
    margin: 2rem 0 1.25rem;
    gap: 0.75rem;
  }
  .promises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }
  .promises li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }
  .promises :global(.icon) {
    color: var(--success);
  }

  /* The sample question sits on top of a deck: the rest of the bank. */
  .hero-sample {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .hero-sample::before {
    content: '';
    position: absolute;
    inset: -2.5rem -2rem -1rem;
    z-index: -1;
    background-image: radial-gradient(var(--ink-3) 1px, transparent 1.3px);
    background-size: 20px 20px;
    mask-image: radial-gradient(closest-side, #000 30%, transparent);
    -webkit-mask-image: radial-gradient(closest-side, #000 30%, transparent);
    opacity: 0.35;
  }
  .sample-label {
    margin: 0 0 0.75rem;
    color: var(--ink-2);
    font-weight: 550;
  }
  .deck {
    position: relative;
    isolation: isolate;
  }
  .deck :global(.check) {
    position: relative;
    z-index: 2;
    box-shadow: var(--shadow-lg);
  }
  .deck-card {
    position: absolute;
    inset: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transform-origin: 50% 100%;
  }
  .deck-1 {
    z-index: 1;
    transform: translateY(12px) scale(0.96);
    opacity: 0.85;
  }
  .deck-2 {
    z-index: 0;
    transform: translateY(24px) scale(0.92);
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .deck-1,
    .deck-2 {
      animation: deal 0.7s var(--ease) both;
    }
    .deck-1 {
      animation-delay: 0.08s;
    }
    .deck-2 {
      animation-delay: 0.16s;
    }
    @keyframes deal {
      from {
        transform: none;
        opacity: 0;
      }
    }
  }

  .facts,
  .loop {
    margin-top: clamp(4rem, 3rem + 3vw, 6rem);
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 1rem;
    padding: 0;
  }
  .fact-grid > div {
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .fact-grid > div + div {
    border-left: 1px solid var(--border);
  }
  .fact-grid dt {
    margin-bottom: 0.6rem;
    color: var(--ink-3);
    font-size: 0.85rem;
    font-weight: 550;
  }
  .fact-grid dd {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .fact-value {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ink);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .domains-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .domains h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .domains-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 550;
    text-decoration: none;
  }
  .split {
    display: flex;
    gap: 4px;
    height: 0.75rem;
    margin-bottom: 1rem;
  }
  .split span {
    border-radius: 999px;
  }
  .split-0 {
    background: var(--accent);
  }
  .split-1 {
    background: color-mix(in srgb, var(--accent) 45%, var(--surface));
  }
  .domains ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .domains li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
  }
  .domains li strong {
    margin-left: auto;
    white-space: nowrap;
  }
  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
    border-radius: 3px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .step-icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent-edge);
  }
  .steps h3 {
    margin: 1rem 0 0.4rem;
  }
  .step-no {
    color: var(--ink-3);
    font-weight: 600;
  }
  .steps p {
    color: var(--ink-2);
  }
  .steps a {
    font-weight: 550;
    text-decoration: none;
  }
  .steps a:hover {
    text-decoration: underline;
  }

  /* The one inverted panel on the page. */
  .plan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    flex-wrap: wrap;
    margin-top: clamp(4rem, 3rem + 3vw, 6rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--inverse-edge);
    border-radius: var(--radius-xl);
    background: var(--inverse);
    color: var(--inverse-ink);
  }
  .plan h2 {
    margin-bottom: 0.35rem;
  }
  .plan p {
    margin: 0;
    max-width: 58ch;
    color: var(--inverse-ink-2);
  }
  .plan-btn {
    border-color: transparent;
    background: var(--inverse-ink);
    color: var(--inverse);
  }
  .plan-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--inverse-ink) 88%, var(--inverse));
    color: var(--inverse);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .fact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fact-grid > div:nth-child(3) {
      border-left: 0;
    }
    .fact-grid > div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .fact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .fact-grid > div + div {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
