---
import Base from '../../layouts/Base.astro';
import PracticeHub from '../../components/PracticeHub.svelte';
import { codeQuestionCount, moduleCoverage, questionRefs } from '../../lib/pageData';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Practice"
  description="Spaced-repetition practice for Exam AI-901: quick sets, rapid fire, single topics, your weakest areas and the questions you got wrong."
  active="practice"
>
  <div class="wrap">
    <PracticeHub client:load {base} refs={questionRefs} modules={moduleCoverage} codeCount={codeQuestionCount} />
  </div>
</Base>
