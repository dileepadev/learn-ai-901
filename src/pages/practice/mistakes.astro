---
import Base from '../../layouts/Base.astro';
import PracticeHub from '../../components/PracticeHub.svelte';
import { moduleCoverage, questionRefs } from '../../lib/pageData';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Questions you got wrong"
  description="Every AI-901 practice question currently sitting on a wrong answer, in one set."
  active="practice"
>
  <div class="wrap">
    <PracticeHub client:load {base} refs={questionRefs} modules={moduleCoverage} fixedMode="mistakes" />
  </div>
</Base>
