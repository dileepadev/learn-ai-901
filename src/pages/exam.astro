---
import Base from '../layouts/Base.astro';
import ExamRunner from '../components/ExamRunner.svelte';
import { EXAM_QUESTIONS } from '../data/questions';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Practice exam"
  description="A timed AI-901 practice exam, weighted like the real blueprint, with nothing marked until the end and a topic-by-topic report."
  active="exam"
>
  <div class="wrap">
    <ExamRunner client:load {base} available={EXAM_QUESTIONS.length} />
  </div>
</Base>
